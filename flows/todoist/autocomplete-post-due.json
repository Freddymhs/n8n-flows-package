        "jsCode": "const PERSONAL_HABITS_PROJECT_ID = '6W4Vj63fmjqJqRgX';\n\nconst now = new Date();\nconst tasks = $input.first().json.results || [];\n\nconst overdueTasks = tasks.filter(item => {\n  const { project_id, due } = item;\n  \n  const isPersonalHabit = project_id === PERSONAL_HABITS_PROJECT_ID;\n  const hasDueDate = due && due['date'];\n\n  if (!isPersonalHabit || !hasDueDate) return false;\n  \n  const dueDate = new Date(String(due['date']));\n  const isOverdue = dueDate < now;\n  \n  return isOverdue;\n});\n\nreturn overdueTasks.map(task => ({ json: task }));\n// return overdueTasks.map(task => ({ json: task }));\n"
      },
